# ---------------------------------------------------------------------------
# Server-side only (Vercel project env). The browser never sees these: it
# learns the CA and launch state from /api/chain. No VITE_ variables needed.
# ---------------------------------------------------------------------------

# Robinhood Chain RPC (public, rate-limited). An Alchemy URL works too; if its
# plan caps eth_getLogs ranges, lower RATTERY_LOGS_RANGE (Alchemy free = 10).
RATTERY_RPC=https://rpc.mainnet.chain.robinhood.com

# Paste after the Pons launch. Empty = pre-launch mode (site runs the demo tape).
RATTERY_CA=
# Block of the launch transaction (decimal or 0x). Required with the CA: the
# server finds TokenLaunched there and derives the curve + v4 PoolId from it.
RATTERY_BIRTH_BLOCK=

# Optional overrides, only if auto-discovery ever disagrees with the explorer.
# RATTERY_CURVE=0x...
# RATTERY_POOL_ID=0x...

# Tape chunking. Chunks behind the head are cached at the CDN for a year.
# RATTERY_CHUNK_BLOCKS=1200
# RATTERY_LOGS_RANGE=1200

# ---------------------------------------------------------------------------
# Local development only: proxy /api to a deployed site while running
# `npm run dev` (plain Vite has no functions). Or use `vercel dev`.
# ---------------------------------------------------------------------------
# RATTERY_API_PROXY=https://rattery.tech
